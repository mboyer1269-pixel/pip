<?xml version="1.0" encoding="utf-8"?>
<!-- SEC-1: no cleartext anywhere, no exception. System trust anchors only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- ACP orchestrator domain-config is added here, host by host, once SPEC Q-1 is answered (Phase 6). -->
</network-security-config>
